# Neon: use the direct URL for schema migration and the pooled URL in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# CONNECTION_STRING may be used instead when your host provides one generic variable.

# Keep this server-only. Never prefix it with NEXT_PUBLIC_.
APP_ORIGIN="https://your-app.vercel.app"
# At least 32 random characters. Keep this server-only and stable.
ACCESS_CODE_SECRET="replace-with-at-least-32-random-characters"
